# Conexão com o Postgres (container capivara-db na rede Docker)
DATABASE_URL=postgresql://appuser:SENHA@capivara-db:5432/capivara

# Porta HTTP local — será o alvo do Cloudflare Tunnel
PORT=3001

# CORS — origem da Vercel (etapa 3)
ALLOWED_ORIGIN=https://seu-app.vercel.app

# Chave secreta — enviada pelo Next.js em x-api-key (etapa 3)
API_KEY=gere-com-openssl-rand-hex-32
